#!/usr/bin/env bash
# satpost: first-time setup and everyday wallet commands.
#
# Wallet commands run phoenix-cli inside the phoenixd container. phoenix-cli reads the
# full-access password from phoenixd's own phoenix.conf, so that password never appears on
# a command line or leaves the container. Setup writes secrets to .env with shell builtins
# only, never as process arguments: on a shared host every user can read every process's
# arguments.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
start_dir=$PWD # where relative paths given on the command line start from
# Compose resolves a relative COMPOSE_FILE against the working directory, not the project.
cd "$root"
env_file=$root/.env

envvar() { # NAME from the environment, else the last NAME=value in .env, read the way compose does
  local line value=${!1:-}
  if [ -z "$value" ] && [ -f "$env_file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ $line == "$1="* ]] && value=${line#*=}
    done <"$env_file"
    case $value in
      \"*\"*) value=${value#\"} && value=${value%%\"*} ;;
      \'*\'*) value=${value#\'} && value=${value%%\'*} ;;
      *) # unquoted: a # after whitespace starts a comment, and trailing whitespace goes
        value=${value%%[[:space:]]#*}
        value=${value%"${value##*[![:space:]]}"}
        ;;
    esac
  fi
  printf '%s' "$value"
}

setvar() { # replace NAME=... in .env, or append it; the new file replaces the old one in one step
  local name=$1 value=$2 line found= lines=() tmp
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line == "$name="* ]]; then
      lines+=("$name=$value")
      found=1
    else
      lines+=("$line")
    fi
  done <"$env_file"
  [ -n "$found" ] || lines+=("$name=$value")
  tmp=$(mktemp "$env_file.XXXXXX")
  printf '%s\n' "${lines[@]}" >"$tmp"
  mv -f "$tmp" "$env_file"
}

read -r -a docker <<<"$(envvar SATPOST_DOCKER)"
[ ${#docker[@]} -gt 0 ] || docker=(docker)
dc() { "${docker[@]}" compose --project-directory "$root" "$@"; }
# phoenix-cli never reads stdin; without </dev/null docker would swallow piped input.
cli() { dc exec -T phoenixd /phoenix/phoenix-cli "$@" </dev/null; }

volume_has() { # yes or no: anything matching the pattern in the service's volume? fails if unsure
  local answer script="for f in $2; do [ -e \"\$f\" ] && { echo yes; exit; }; done; echo no"
  answer=$(dc run --rm --no-deps -T --entrypoint sh "$1" -c "$script" </dev/null 2>/dev/null) ||
    answer=
  if [[ $answer != yes && $answer != no ]]; then
    echo "Couldn't look inside the $1 volume." >&2
    return 1
  fi
  printf '%s' "$answer"
}

high_feerate() { # a warning when a feerate looks like a typo
  (($1 <= 100)) || echo "$1 sat/vB is very high. Check current fees before you confirm."
}

confirm() {
  local answer
  read -r -p "Type \"$1\" to confirm: " answer
  [ "$answer" = "$1" ] || { echo "cancelled"; exit 1; }
}

setup() {
  if [ ! -f "$env_file" ]; then
    cp "$root/.env.example" "$env_file"
    chmod 600 "$env_file"
    echo "Created .env. Review it (TS_HOSTNAME, TS_AUTHKEY, SATPOST_DOCKER), then run setup again."
    return
  fi
  chmod 600 "$env_file"

  echo "Starting tailscale and phoenixd..."
  dc up -d ts phoenixd

  local random installed
  if [ -z "$(envvar LNBITS_FIRST_INSTALL_TOKEN)" ]; then
    # LNbits takes a changed token as a request to reset its admin settings, so an install
    # that has already started never gets a new one from here.
    installed=$(volume_has lnbits /app/data/database.sqlite3) || exit 1
    if [ "$installed" = yes ]; then
      echo "LNbits is already installed, so LNBITS_FIRST_INSTALL_TOKEN stays empty." >&2
    else
      random=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
      setvar LNBITS_FIRST_INSTALL_TOKEN "$random"
    fi
  fi
  if [ -z "$(envvar LNBITS_AUTH_SECRET_KEY)" ]; then
    random=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
    setvar LNBITS_AUTH_SECRET_KEY "$random"
  fi

  # phoenixd writes its passwords to phoenix.conf on first start.
  local password= previous
  for _ in $(seq 60); do
    password=$(cli_conf http-password-limited-access)
    [ -n "$password" ] && break
    sleep 2
  done
  if [ -z "$password" ]; then
    echo "phoenixd hasn't written its passwords. Check: ${docker[*]} compose logs phoenixd" >&2
    exit 1
  fi
  previous=$(envvar PHOENIXD_LIMITED_PASSWORD)
  if [ "$previous" != "$password" ]; then
    setvar PHOENIXD_LIMITED_PASSWORD "$password"
    if [ -n "$previous" ]; then
      echo "phoenixd's receive-only password changed. An installed LNbits keeps its own copy in" >&2
      echo "its database: update it in LNbits' admin, under the funding source settings." >&2
    fi
  fi

  echo "Starting lnbits..."
  dc up -d lnbits
  # On its first start LNbits installs the LNURLp extension but only loads it after a
  # restart, so wait for that start to finish and restart it once.
  if ! dc exec -T lnbits test -f /app/data/.satpost-extensions-loaded 2>/dev/null; then
    local logs
    for _ in $(seq 90); do
      # Read the whole log first: grep -q closing a pipe early would fail it under pipefail.
      logs=$(dc logs lnbits 2>/dev/null) || true
      [[ $logs == *'Application startup complete'* ]] && break
      sleep 2
    done
    dc restart lnbits >/dev/null
    dc exec -T lnbits touch /app/data/.satpost-extensions-loaded
  fi

  cat <<EOF

Next, in order (README.md has the details):
  1. Tailscale: if TS_AUTHKEY was empty, open the login link in: satpost logs ts
     Apply the ACL from docs/security.md before going further.
  2. Back up phoenixd's seed yourself, on paper only: satpost seed
  3. LNbits: open https://$(envvar TS_HOSTNAME).<your-tailnet>.ts.net:8443 and complete the first
     install with LNBITS_FIRST_INSTALL_TOKEN from .env.
EOF
}

bip39_valid() { # words from the BIP39 English list, with a matching checksum; builtins only
  local wordlist=$root/lib/bip39-english.txt word idx b i=0 n=0 bits= hex= byte k
  local -A index=()
  while IFS= read -r word; do index[$word]=$i; i=$((i + 1)); done <"$wordlist"
  for word in "$@"; do
    n=$((n + 1))
    # The position, not the word: a typo can be close enough to give a word away.
    [ -n "${index[$word]+x}" ] || { echo "Word $n isn't on the BIP39 word list." >&2; return 1; }
    idx=${index[$word]}
    for ((b = 10; b >= 0; b--)); do bits+=$(((idx >> b) & 1)); done
  done
  local ent=$((${#bits} * 32 / 33))
  for ((k = 0; k < ent; k += 8)); do printf -v byte '%02x' "$((2#${bits:k:8}))"; hex+=$byte; done
  local digest first want= got=${bits:ent}
  # sha256sum reads the entropy on stdin, so it never appears in a process list.
  digest=$(for ((k = 0; k < ${#hex}; k += 2)); do printf "\\x${hex:k:2}"; done | sha256sum)
  first=$((16#${digest:0:2}))
  for ((b = 7; b >= 0; b--)); do want+=$(((first >> b) & 1)); done
  [ "${want:0:${#got}}" = "$got" ] || { echo "The words don't form a valid seed (checksum mismatch)." >&2; return 1; }
}

never_used() { # phoenixd answers, holds nothing, and has never received or sent a payment
  # A closed channel's funds sit in a wallet getbalance doesn't report, and fee credit reads 0
  # until ACINQ resends it after a restart, so a wallet that has seen any payment has had funds.
  local channels balance incoming outgoing empty='^[[:space:]]*\[[[:space:]]*\][[:space:]]*$'
  channels=$(cli listchannels 2>/dev/null) || return 1
  balance=$(cli getbalance 2>/dev/null) || return 1
  incoming=$(cli listincomingpayments --limit 1 2>/dev/null) || return 1
  outgoing=$(cli listoutgoingpayments --limit 1 --all true 2>/dev/null) || return 1
  [[ $channels =~ $empty && $incoming =~ $empty && $outgoing =~ $empty ]] || return 1
  [[ $balance == *'"balanceSat"'* ]] || return 1
  [[ ! $balance =~ \"[A-Za-z]*Sat\":[[:space:]]*[1-9] ]]
}

refuse_replace() {
  echo "Refusing to replace the seed: phoenixd isn't running, or this wallet has a channel," >&2
  echo "funds, fee credit or payment history. Replacing it could strand funds." >&2
  exit 1
}

restore() {
  [ -f "$env_file" ] || { echo "Run setup first to create .env." >&2; exit 1; }
  local replace= seed db=no
  [ "${1:-}" = --replace ] && replace=1
  # One-off phoenixd containers join the ts container's namespace, so it has to be up.
  dc up -d ts </dev/null >/dev/null
  seed=$(volume_has phoenixd /phoenix/.phoenix/seed.dat) || exit 1
  if [ "$seed" = yes ]; then
    if [ -z "$replace" ]; then
      echo "This wallet already has a seed; refusing to overwrite it." >&2
      echo "A wallet that has never had funds or payments can take another seed with --replace." >&2
      exit 1
    fi
    # A seed that never started a wallet has no database yet, e.g. one phoenixd rejected.
    db=$(volume_has phoenixd '/phoenix/.phoenix/phoenix.*.db') || exit 1
    if [ "$db" = yes ] && ! never_used; then refuse_replace; fi
  fi
  local words again word list check
  if [ -t 0 ]; then
    read -r -s -p "Type the words separated by spaces, then Enter (nothing is shown): " words
    echo
    read -r -s -p "Type them again to check: " again
    echo
    read -r -a check <<<"$again"
  else
    words=$(cat)
  fi
  read -r -a list <<<"${words//$'\n'/ }"
  if [ -t 0 ] && [ "${list[*]}" != "${check[*]}" ]; then
    echo "The two entries don't match. Nothing was changed." >&2
    exit 1
  fi
  for word in "${list[@]}"; do
    [[ $word =~ ^[a-z]+$ ]] || { echo "Words are lowercase letters only." >&2; exit 1; }
  done
  if [ ${#list[@]} -ne 12 ] && [ ${#list[@]} -ne 24 ]; then
    echo "Expected 12 or 24 words, got ${#list[@]}." >&2
    exit 1
  fi
  bip39_valid "${list[@]}" || { echo "Nothing was changed." >&2; exit 1; }
  if [ "$seed" = yes ]; then
    # Check again: a payment could have arrived while the words were being typed.
    if [ "$db" = yes ] && ! never_used; then refuse_replace; fi
    # The old wallet's database is named after its node, so it goes with the old seed.
    # phoenix.conf stays, and with it the passwords LNbits and any dashboard use.
    dc stop phoenixd </dev/null >/dev/null
    dc run --rm --no-deps -T --entrypoint sh phoenixd -c \
      'rm -f /phoenix/.phoenix/seed.dat /phoenix/.phoenix/phoenix.*.db /phoenix/.phoenix/phoenix.*.db-*' </dev/null
  fi
  # set -C: never overwrite a seed, even one that appeared since the check above.
  if ! printf '%s\n' "${list[*]}" | dc run --rm --no-deps -T --entrypoint sh phoenixd -c \
    'set -C; umask 077; cat >/phoenix/.phoenix/seed.dat'; then
    echo "Couldn't write the seed; phoenixd's volume may already have one. Run restore again." >&2
    exit 1
  fi
  echo "Seed written. Now run: satpost setup"
}

seed() {
  # Refuses unless both ends are a terminal, so the words can't end up in a pipe, a log or a
  # tool's captured output.
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "satpost seed only runs in an interactive terminal." >&2
    exit 1
  fi
  echo "This shows the words that control your funds. Make sure nobody can see your screen."
  confirm show
  dc exec -T phoenixd cat /phoenix/.phoenix/seed.dat </dev/null
  printf '\n\nWrite them on paper, then clear the screen and your scrollback.\n'
}

export_history() {
  [ $# -eq 1 ] || { usage >&2; exit 2; }
  local out path= dest=$1
  [[ $dest == /* ]] || dest=$start_dir/$dest
  out=$(cli exportcsv)
  [[ $out =~ (/phoenix/[^[:space:]]*\.csv) ]] && path=${BASH_REMATCH[1]}
  [ -n "$path" ] || { echo "phoenixd didn't report an export file: $out" >&2; exit 1; }
  # Payment history is private: only you can read the file.
  (umask 077 && dc exec -T phoenixd cat "$path" </dev/null >"$dest")
  chmod 600 "$dest"
  dc exec -T phoenixd rm -f "$path" </dev/null
  echo "Wrote the payment history to $dest"
}

cli_conf() { # read one key from phoenixd's phoenix.conf; prints nothing if unavailable
  dc exec -T phoenixd sed -n "s/^$1=//p" /phoenix/.phoenix/phoenix.conf </dev/null 2>/dev/null || true
}

liquidity_sats() { # what PHOENIXD_AUTO_LIQUIDITY buys, 0 when off; same default as compose.yml
  case $(envvar PHOENIXD_AUTO_LIQUIDITY) in
    '' | 2m) echo 2000000 ;;
    5m) echo 5000000 ;;
    10m) echo 10000000 ;;
    off) echo 0 ;;
    *) echo "PHOENIXD_AUTO_LIQUIDITY must be off, 2m, 5m or 10m." >&2 && return 1 ;;
  esac
}

fees() {
  # Estimates: phoenixd's estimate prices mining at electrum's feerate, while the purchase uses
  # ACINQ's. With no coins of its own in the funding transaction, lightning-kmp opens the first
  # channel at up to 2.5 times the feerate, and keeps a payment as fee credit if it doesn't
  # exceed the fee at up to 3.8 times. phoenixd also refuses a purchase whose mining fee is over
  # its limit, 1% of the block by default.
  local amount=${1:-0} block liquidity estimate channels fee mining= service=
  [[ $amount =~ ^(0|[1-9][0-9]*)$ ]] || { usage >&2; exit 2; }
  block=$(liquidity_sats) || exit 1
  if ((block == 0)); then
    echo "Auto-liquidity is off, so phoenixd refuses any payment that doesn't fit your channel."
    return
  fi
  liquidity=$((block + amount))
  estimate=$(cli estimateliquidityfees --amountSat "$liquidity")
  [[ $estimate =~ \"miningFeeSat\":[[:space:]]*([0-9]+) ]] && mining=${BASH_REMATCH[1]}
  [[ $estimate =~ \"serviceFeeSat\":[[:space:]]*([0-9]+) ]] && service=${BASH_REMATCH[1]}
  [ -n "$mining" ] && [ -n "$service" ] || { printf '%s\n' "$estimate" >&2; exit 1; }
  channels=$(cli listchannels)
  if [[ ! $channels =~ ^[[:space:]]*\[[[:space:]]*\][[:space:]]*$ ]]; then
    fee=$((service + mining))
    echo "A payment that doesn't fit your channel buys $liquidity sats of liquidity for about $fee"
    echo "sats ($service service, $mining mining), plus your share of the splice's mining fee."
  else
    fee=$((service + (mining * 5 + 1) / 2))
    echo "Opening your first channel buys $liquidity sats of liquidity for about $fee sats"
    echo "($service service, about $((fee - service)) mining)."
  fi
  if ((mining > block / 100)); then
    echo "At today's feerate the mining fee is over phoenixd's limit of 1% of the block, so it"
    echo "would refuse a payment that needs liquidity. Wait for lower fees."
    return
  fi
  [[ $channels =~ ^[[:space:]]*\[[[:space:]]*\][[:space:]]*$ ]] && ((amount > 0)) || return 0
  if ((amount > service + (mining * 38 + 9) / 10)); then
    echo "A payment of $amount sats should open it, and you'd keep about $((amount - fee))."
  else
    echo "A payment of $amount sats may be too small to open it: phoenixd would keep it as fee"
    echo "credit, which is non-refundable."
  fi
}

usage() {
  cat <<'EOF'
usage: satpost <command>

  setup                                first start; safe to re-run
  restore [--replace]                  put your own seed in place: before the first setup, or with
                                       --replace on a wallet that has never had funds or payments
  seed                                 show the seed, to write it down (interactive only)
  up                                   apply changes to .env, e.g. SATPOST_SERVE
  update                               pull the versions set in .env and restart
  logs [service]                       follow the logs (ts, phoenixd or lnbits)
  info                                 node id, channels and version
  balance                              balance and fee credit, in sats
  channels                             channel capacity and inbound liquidity
  payments [n]                         the last n incoming payments (default 10)
  fees [sats]                          estimated fee for the liquidity an incoming payment of
                                       [sats] would buy, and whether it opens your first channel
  invoice <sats> [description]         create an invoice, e.g. to fund the channel
  export <file.csv>                    save the payment history (records, not a wallet backup)
  pay <invoice>                        pay a Lightning invoice
  pay <user@domain> <sats> [message]   pay a Lightning address
  sweep <address> <sats> <sat/vB>      send on-chain (a splice-out); check the address on your
                                       signing device first
  bumpfee <sat/vB>                     speed up a stuck sweep; the extra mining fee comes out of
                                       your balance
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  setup) setup ;;
  restore) restore "$@" ;;
  seed) seed ;;
  up) dc up -d ;;
  update) dc pull && dc up -d ;;
  logs) dc logs --tail 100 -f "$@" ;;
  info) cli getinfo ;;
  balance) cli getbalance ;;
  channels) cli listchannels ;;
  payments) cli listincomingpayments --limit "${1:-10}" ;;
  fees) fees "$@" ;;
  export) export_history "$@" ;;
  invoice)
    [[ $# -ge 1 && $1 =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }
    cli createinvoice --amountSat "$1" --description "${2:-satpost}"
    ;;
  pay)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    if [[ $1 == *@* ]]; then
      [[ $# -ge 2 && $2 =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }
      echo "Paying $2 sats to $1"
      confirm pay
      if [ $# -ge 3 ]; then
        cli paylnaddress --address "$1" --amountSat "$2" --message "$3"
      else
        cli paylnaddress --address "$1" --amountSat "$2"
      fi
    else
      cli decodeinvoice --invoice "$1"
      confirm pay
      cli payinvoice --invoice "$1"
    fi
    ;;
  sweep)
    [[ $# -eq 3 && $2 =~ ^[1-9][0-9]*$ && $3 =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }
    printf 'Sending %s sats on-chain at %s sat/vB to:\n\n    ' "$2" "$3"
    printf '%s\n' "$1" | fold -w4 | paste -sd' ' -
    printf '\nCompare every group with the address shown on your signing device.\n'
    high_feerate "$3"
    confirm send
    cli sendtoaddress --address "$1" --amountSat "$2" --feerateSatByte "$3"
    ;;
  bumpfee)
    [[ $# -eq 1 && $1 =~ ^[1-9][0-9]*$ ]] || { usage >&2; exit 2; }
    echo "Bumping the channel's unconfirmed transaction to $1 sat/vB. The extra mining fee comes"
    echo "out of your balance."
    high_feerate "$1"
    confirm bump
    cli bumpfee --feerateSatByte "$1"
    ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
