#!/usr/bin/env bash
# satpost: first-time setup and everyday wallet commands.
#
# Wallet commands run phoenix-cli inside the phoenixd container. phoenix-cli reads the
# full-access password from phoenixd's own phoenix.conf, so that password never appears on
# a command line or leaves the container. Setup writes secrets to .env with shell builtins
# only, never as process arguments: on a shared host every user can read every process's
# arguments.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# Compose resolves a relative COMPOSE_FILE against the working directory, not the project.
cd "$root"
env_file=$root/.env

envvar() { # NAME from the environment, else the last NAME=value in .env
  local line value=${!1:-}
  if [ -z "$value" ] && [ -f "$env_file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ $line == "$1="* ]] && value=${line#*=}
    done <"$env_file"
  fi
  printf '%s' "$value"
}

setvar() { # replace NAME=... in .env, or append it
  local name=$1 value=$2 line found= lines=()
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line == "$name="* ]]; then
      lines+=("$name=$value")
      found=1
    else
      lines+=("$line")
    fi
  done <"$env_file"
  [ -n "$found" ] || lines+=("$name=$value")
  printf '%s\n' "${lines[@]}" >"$env_file"
}

read -r -a docker <<<"$(envvar SATPOST_DOCKER)"
[ ${#docker[@]} -gt 0 ] || docker=(docker)
dc() { "${docker[@]}" compose --project-directory "$root" "$@"; }
# phoenix-cli never reads stdin; without </dev/null docker would swallow piped input.
cli() { dc exec -T phoenixd /phoenix/phoenix-cli "$@" </dev/null; }

confirm() {
  local answer
  read -r -p "Type \"$1\" to confirm: " answer
  [ "$answer" = "$1" ] || { echo "cancelled"; exit 1; }
}

setup() {
  if [ ! -f "$env_file" ]; then
    cp "$root/.env.example" "$env_file"
    chmod 600 "$env_file"
    echo "Created .env. Review it (TS_HOSTNAME, TS_AUTHKEY, SATPOST_DOCKER), then run setup again."
    return
  fi
  chmod 600 "$env_file"

  local random
  if [ -z "$(envvar LNBITS_FIRST_INSTALL_TOKEN)" ]; then
    random=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
    setvar LNBITS_FIRST_INSTALL_TOKEN "$random"
  fi
  if [ -z "$(envvar LNBITS_AUTH_SECRET_KEY)" ]; then
    random=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
    setvar LNBITS_AUTH_SECRET_KEY "$random"
  fi

  echo "Starting tailscale and phoenixd..."
  dc up -d ts phoenixd

  # phoenixd writes its passwords to phoenix.conf on first start.
  local password=
  for _ in $(seq 60); do
    password=$(cli_conf http-password-limited-access)
    [ -n "$password" ] && break
    sleep 2
  done
  if [ -z "$password" ]; then
    echo "phoenixd hasn't written its passwords. Check: ${docker[*]} compose logs phoenixd" >&2
    exit 1
  fi
  if [ "$(envvar PHOENIXD_LIMITED_PASSWORD)" != "$password" ]; then
    setvar PHOENIXD_LIMITED_PASSWORD "$password"
  fi

  echo "Starting lnbits..."
  dc up -d lnbits
  # On its first start LNbits installs the LNURLp extension but only loads it after a
  # restart, so wait for that start to finish and restart it once.
  if ! dc exec -T lnbits test -f /app/data/.satpost-extensions-loaded 2>/dev/null; then
    for _ in $(seq 90); do
      dc logs lnbits 2>/dev/null | grep -q 'Application startup complete' && break
      sleep 2
    done
    dc restart lnbits >/dev/null
    dc exec -T lnbits touch /app/data/.satpost-extensions-loaded
  fi

  cat <<EOF

Next, in order (README.md has the details):
  1. Tailscale: if TS_AUTHKEY was empty, open the login link in: satpost logs ts
     Apply the ACL from docs/security.md before going further.
  2. Back up phoenixd's seed yourself, on paper only: satpost seed
  3. LNbits: open https://$(envvar TS_HOSTNAME).<your-tailnet>.ts.net:8443 and complete the first
     install with LNBITS_FIRST_INSTALL_TOKEN from .env.
EOF
}

brand_new() { # phoenixd answers, and has no channel and nothing in any balance or fee credit
  local channels balance
  channels=$(cli listchannels 2>/dev/null) || return 1
  balance=$(cli getbalance 2>/dev/null) || return 1
  [[ $channels =~ ^[[:space:]]*\[[[:space:]]*\][[:space:]]*$ ]] || return 1
  [[ $balance == *'"balanceSat"'* ]] || return 1
  [[ ! $balance =~ \"[A-Za-z]*Sat\":[[:space:]]*[1-9] ]]
}

restore() {
  [ -f "$env_file" ] || { echo "Run setup first to create .env." >&2; exit 1; }
  local replace=
  [ "${1:-}" = --replace ] && replace=1
  # One-off phoenixd containers join the ts container's namespace, so it has to be up.
  dc up -d ts </dev/null >/dev/null
  if dc run --rm --no-deps -T --entrypoint test phoenixd -f /phoenix/.phoenix/seed.dat </dev/null 2>/dev/null; then
    if [ -z "$replace" ]; then
      echo "This wallet already has a seed; refusing to overwrite it." >&2
      echo "A wallet that has never had a channel or funds can take another seed with --replace." >&2
      exit 1
    fi
    if ! brand_new; then
      echo "Refusing to replace the seed: phoenixd isn't running, or this wallet has a channel," >&2
      echo "a balance or fee credit. Replacing it would strand those funds." >&2
      exit 1
    fi
  fi
  local words word list
  if [ -t 0 ]; then
    read -r -s -p "Type the 12 words separated by spaces, then Enter (nothing is shown): " words
    echo
  else
    words=$(cat)
  fi
  read -r -a list <<<"${words//$'\n'/ }"
  for word in "${list[@]}"; do
    [[ $word =~ ^[a-z]+$ ]] || { echo "Words are lowercase letters only." >&2; exit 1; }
  done
  if [ ${#list[@]} -ne 12 ] && [ ${#list[@]} -ne 24 ]; then
    echo "Expected 12 or 24 words, got ${#list[@]}." >&2
    exit 1
  fi
  if [ -n "$replace" ]; then
    # The old wallet's database is named after its node, so it goes with the old seed.
    # phoenix.conf stays, and with it the passwords LNbits and any dashboard use.
    dc stop phoenixd </dev/null >/dev/null
    dc run --rm --no-deps -T --entrypoint sh phoenixd -c \
      'rm -f /phoenix/.phoenix/seed.dat /phoenix/.phoenix/phoenix.*.db /phoenix/.phoenix/phoenix.*.db-*' </dev/null
  fi
  printf '%s\n' "${list[*]}" |
    dc run --rm --no-deps -T --entrypoint sh phoenixd -c 'umask 077; cat >/phoenix/.phoenix/seed.dat'
  echo "Seed written. Now run: satpost setup"
}

seed() {
  # Refuses unless both ends are a terminal, so the words can't end up in a pipe, a log or a
  # tool's captured output.
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "satpost seed only runs in an interactive terminal." >&2
    exit 1
  fi
  echo "This shows the 12 words that control your funds. Make sure nobody can see your screen."
  confirm show
  dc exec -T phoenixd cat /phoenix/.phoenix/seed.dat </dev/null
  printf '\n\nWrite them on paper, then clear the screen and your scrollback.\n'
}

export_history() {
  [ $# -eq 1 ] || { usage >&2; exit 2; }
  local out path
  out=$(cli exportcsv)
  path=$(printf '%s\n' "$out" | grep -o '/phoenix/[^ ]*\.csv' | head -1)
  [ -n "$path" ] || { echo "phoenixd didn't report an export file: $out" >&2; exit 1; }
  dc exec -T phoenixd cat "$path" </dev/null >"$1"
  dc exec -T phoenixd rm -f "$path" </dev/null
  echo "Wrote the payment history to $1"
}

cli_conf() { # read one key from phoenixd's phoenix.conf; prints nothing if unavailable
  dc exec -T phoenixd sed -n "s/^$1=//p" /phoenix/.phoenix/phoenix.conf </dev/null 2>/dev/null || true
}

liquidity_sats() {
  case $(envvar PHOENIXD_AUTO_LIQUIDITY) in
    5m) echo 5000000 ;;
    10m) echo 10000000 ;;
    *) echo 2000000 ;;
  esac
}

usage() {
  cat <<'EOF'
usage: satpost <command>

  setup                                first start; safe to re-run
  restore [--replace]                  put your own seed in place: before the first setup, or with
                                       --replace on a wallet that has never had a channel or funds
  seed                                 show the seed, to write it down (interactive only)
  up                                   apply changes to .env, e.g. SATPOST_SERVE
  update                               pull the versions set in .env and restart
  logs [service]                       follow the logs (ts, phoenixd or lnbits)
  info                                 node id, channels and version
  balance                              balance and fee credit, in sats
  channels                             channel capacity and inbound liquidity
  payments [n]                         the last n incoming payments (default 10)
  fees [sats]                          fee for the liquidity purchase an incoming payment of
                                       [sats] would trigger; fund the channel with more than this
  invoice <sats> [description]         create an invoice, e.g. to fund the channel
  export <file.csv>                    save the payment history (records, not a wallet backup)
  pay <invoice>                        pay a Lightning invoice
  pay <user@domain> <sats> [message]   pay a Lightning address
  sweep <address> <sats> <sat/vB>      send on-chain (a splice-out); check the address on your
                                       signing device first
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  setup) setup ;;
  restore) restore "$@" ;;
  seed) seed ;;
  up) dc up -d ;;
  update) dc pull && dc up -d ;;
  logs) dc logs --tail 100 -f "$@" ;;
  info) cli getinfo ;;
  balance) cli getbalance ;;
  channels) cli listchannels ;;
  payments) cli listincomingpayments --limit "${1:-10}" ;;
  fees) cli estimateliquidityfees --amountSat "$(($(liquidity_sats) + ${1:-0}))" ;;
  export) export_history "$@" ;;
  invoice)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    cli createinvoice --amountSat "$1" --description "${2:-satpost}"
    ;;
  pay)
    [ $# -ge 1 ] || { usage >&2; exit 2; }
    if [[ $1 == *@* ]]; then
      [ $# -ge 2 ] || { usage >&2; exit 2; }
      echo "Paying $2 sats to $1"
      confirm pay
      if [ $# -ge 3 ]; then
        cli paylnaddress --address "$1" --amountSat "$2" --message "$3"
      else
        cli paylnaddress --address "$1" --amountSat "$2"
      fi
    else
      cli decodeinvoice --invoice "$1"
      confirm pay
      cli payinvoice --invoice "$1"
    fi
    ;;
  sweep)
    [ $# -eq 3 ] || { usage >&2; exit 2; }
    printf 'Sending %s sats on-chain at %s sat/vB to:\n\n    ' "$2" "$3"
    printf '%s\n' "$1" | fold -w4 | paste -sd' ' -
    printf '\nCompare every group with the address shown on your signing device.\n'
    confirm send
    cli sendtoaddress --address "$1" --amountSat "$2" --feerateSatByte "$3"
    ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
