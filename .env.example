# Copy to .env (bin/satpost setup does this) and keep it private: it holds secrets.

# The Tailscale device name. The public URL becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=pay
# Optional: a single-use, pre-approved auth key tagged tag:pay, from the Tailscale admin
# console. Leave empty to log the device in by hand (see README.md).
TS_AUTHKEY=
# serve: tailnet only. serve.funnel: also opens the two payment paths to the internet.
# Switch only after the channel is funded, then run `satpost up`.
SATPOST_SERVE=serve

# Image versions, pinned by tag and digest so a re-pushed tag can't change what runs. To
# update, see "Updates" in docs/operations.md.
TAILSCALE_VERSION=v1.104.2@sha256:b11583ad2e93e4671128538c88cf11f460444a5d7e449311dd1933a400ab849d
PHOENIXD_VERSION=0.9.3@sha256:f5cbe046104b430052438668b2383416fe1df3c1d808fea1eb76dc139144a32b
LNBITS_VERSION=v1.6.2@sha256:284b9c2a0df9a1f867b4c52b694699fccade513c09368879922ff90bc7bf850e

# mainnet or testnet
PHOENIXD_CHAIN=mainnet
# Inbound liquidity bought per purchase: 2m, 5m or 10m sats. Fees are 1% plus mining.
PHOENIXD_AUTO_LIQUIDITY=2m

# Login cookies need HTTPS. Only set this to false for a local test over plain HTTP.
LNBITS_AUTH_HTTPS_ONLY=true

# How bin/satpost calls Docker, e.g. SATPOST_DOCKER=sudo docker where your user isn't in the
# docker group.
SATPOST_DOCKER=docker

# Optional: the users Tailscale and LNbits run as (defaults 10005 and 10004). Pick ids that no
# account on the host uses.
#TS_UID=10005
#LNBITS_UID=10004

# Filled in by bin/satpost setup. Leave them empty.
LNBITS_FIRST_INSTALL_TOKEN=
LNBITS_AUTH_SECRET_KEY=
PHOENIXD_LIMITED_PASSWORD=
